# Copy to .env and add ONE (or both) keys. Without a key the Copilot uses the built-in local engine.
PORT=3000
# NVIDIA NIM  -> https://build.nvidia.com  (key starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Nebius AI Studio -> https://studio.nebius.com
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
